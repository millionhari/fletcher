# Postgres (docker compose default)
DATABASE_URL=postgres://$USER@localhost:5432/fletcher   # or the docker compose one: postgres://fletcher:fletcher@localhost:5433/fletcher

# --- Auth (Supabase) ---------------------------------------------------------
# Local dev without Supabase: act as DEV_USER_EMAIL (ignored in production).
AUTH_DEV_BYPASS=1
DEV_USER_EMAIL=dev@fletcher.local
# Supabase project → Settings → API. Leave blank when using the bypass.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Where invite links come back to (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase → Authentication → Emails: point each template's link at the app so
# the callback can verify it, e.g.
#   {{ .SiteURL }}/auth/callback?token_hash={{ .TokenHash }}&type={{ .Type }}&next={{ .RedirectTo }}
# and add http://localhost:3000/auth/callback + the production URL under Redirect URLs.

# --- Storage ------------------------------------------------------------------
# local = disk under UPLOAD_DIR (dev). supabase = private bucket, signed URLs (prod).
STORAGE_DRIVER=local
UPLOAD_DIR=.uploads
SUPABASE_STORAGE_BUCKET=fletcher-files
# Shared secret for /api/jobs/tick (Vercel Cron sends it as a bearer token when set).
CRON_SECRET=
# Comma-separated emails allowed to change a workspace's plan / custom quota (no billing yet).
FLETCHER_SUPERADMIN_EMAILS=

# --- Cloud connections (Google Drive picker + Box; Dropbox uses its Chooser, no OAuth) ---
# 32-byte key for encrypting provider tokens: `openssl rand -hex 32`
CONNECTIONS_ENCRYPTION_KEY=
# Google Cloud → OAuth client (Web). Redirect URI: <APP_URL>/api/connections/google_drive/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Cloud → API key restricted to Drive API + Picker API (server: public share links; browser: the picker)
GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_API_KEY=
# Google Cloud project number (the picker's appId)
NEXT_PUBLIC_GOOGLE_APP_ID=
# Dropbox App Console → App key (Chooser domains must include the app origin)
NEXT_PUBLIC_DROPBOX_APP_KEY=
# Box Developer Console → Custom App (OAuth 2.0). Redirect URI: <APP_URL>/api/connections/box/callback
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
# Largest file an import will copy in (bytes). Default 5 GB.
IMPORT_MAX_BYTES=
